# Video NEVER goes in git. A single party is 12-30 GB.
*.mov
*.mp4
*.MOV
*.MP4
*.mkv
*.avi
footage/
clips/

# Model weights (tens to hundreds of MB) and anything downloaded/trained.
*.pt
*.onnx
*.engine
weights/
runs/

# Extracted frames + labels. Regenerable from footage, and large.
frames/
datasets/
labels/*
# ...but hand-called shot outcomes are NOT regenerable. a player played in the
# footage; these calls are the expensive part and the only ground truth a
# make/miss model can be measured against. Keep them.
!labels/shots.csv
!labels/answerkey_*.json
!labels/merges_judged.json
!labels/*-shots.csv

# Probe output (annotated frames, reports) -- regenerable.
out/

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Judged clips are ground truth review produced by hand -- the most expensive
# artifact in this repo. Keep it versioned.
!labels/judged.json

# Credentials. Never committed; see docs/CREDENTIALS.md.
.env
.env.*
!.env.example

# BEGIN:credentials
# Credentials never get committed. See docs/CREDENTIALS.md.
.env
.env.*
!.env.example
# END:credentials

